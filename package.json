{
  "name": "rex-claude-canvas",
  "version": "1.0.0",
  "description": "Terminal + Excalidraw canvas Mac app",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run build:renderer:watch\" \"npm run wait-and-start\"",
    "wait-and-start": "wait-on dist/renderer/bundle.js && electron .",
    "build:renderer": "webpack --config webpack.config.js",
    "build:renderer:watch": "webpack --config webpack.config.js --watch",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:main && npm run build:renderer",
    "start": "electron .",
    "rebuild-native": "npx @electron/rebuild -f -w node-pty"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "concurrently": "^8.0.0",
    "css-loader": "^6.0.0",
    "playwright-core": "^1.61.1",
    "style-loader": "^3.0.0",
    "ts-loader": "^9.0.0",
    "typescript": "^5.0.0",
    "wait-on": "^7.0.0",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.17.0",
    "@excalidraw/mermaid-to-excalidraw": "^2.2.2",
    "@typescript-eslint/typescript-estree": "^8.63.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.3.0",
    "electron": "^31.0.0",
    "glob": "^13.0.6",
    "node-pty": "^1.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  }
}
